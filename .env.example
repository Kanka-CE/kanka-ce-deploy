# ------------------------------------------------------------------
# Kanka Community Edition
# ------------------------------------------------------------------
#
# Notes
# - Replace placeholder passwords and keys before deploying to production. 
#   You can use the provided gen-passwords.sh to replace those automatically.
# - Keep secrets out of version control; use a secrets manager when possible.
# - For production: set APP_ENV=production, enable HTTPS, and use robust credentials.
# ------------------------------------------------------------------


# -------------------------
# Application settings
# -------------------------
APP_NAME="Kanka Community Edition"

# Public URL where Kanka is reachable and contact information.
APP_URL=http://localhost
APP_EMAIL=kanka@your-domain.com

# Allow users to self-register. Set to "false" to disable public signups.
APP_REGISTRATION_ENABLED=true

# Require an invitation to register. 
# When true, users need the invitation password set here.
APP_INVITATION_REQUIRED=false
APP_INVITATION_PASSWORD=

# Port the application listens on inside the container.
# Do not expose this port to the internet!
# Instead, point a reverse proxy to this port.
APP_PORT=8081

# App environment. 
#   - Use "local" only for the setup process and testing.
#   - Use "production" for live systems.
# Important: 
# For the first-time setup, this value has to be set to `local`.
# After the installation is finished, you are free to set this value 
# to `production` and restart the container to apply the changes.
APP_ENV=local

# Application encryption key (should be generated automatically).
APP_KEY=

# Host path for persistent application data 
KANKA_CE_DATA=/opt/kanka-data

FRONT_DOMAIN="${APP_URL}"
APP_DOMAIN="${APP_URL}"
API_DOMAIN="${APP_URL}"


# -------------------------
# Database
# -------------------------
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=kanka
DB_USERNAME=sail
DB_PASSWORD=password
DB_ROOT_PASSWORD=password


# -------------------------
# Cache, sessions, queues
# -------------------------
#BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
CACHE_PREFIX=kanka
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_DRIVER=sync


# -------------------------
# Redis
# -------------------------
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379


# -------------------------
# Mail
# -------------------------
# If you'd like for Kanka-CE to send emails, e.g. for password recovery, 
# you need to connect to an existing mail server, as Kanka-CE does not come
# with a built-in mail server.
# However, Kanka-CE will work fine, even without a mail server connection.

# You only need to change these if you want to use something other
# than an SMTP server. In most cases, you can leave these unchanged.
#MAIL_DRIVER=smtp
#MAIL_MAILER=smtp
#MAIL_ENCRYPTION=tls

# Connect to your SMTP server by providing the URL, Port, 
# a (Kanka-CE-) user and the password for the (Kanka-CE-) user.
MAIL_HOST=mail.your-domain.com   # NO HTTPS:// BEFORE
MAIL_PORT=465
MAIL_USERNAME=kanka-ce@your-domain.com
MAIL_PASSWORD=password

# Sender Information
MAIL_FROM_ADDRESS=${APP_EMAIL}
MAIL_FROM_NAME=${APP_NAME}


# -------------------------
# Frontend/icons
# -------------------------
# Important: 
# For the icons to load, you need to provide a key here.
# 1.) Go to https://fontawesome.com/start to create an account.
# 2.) Create a (free) kit.
# 3.) Go to https://fontawesome.com/kits
# 3.1) Select your kit
# 3.2) copy the id either from the url: https://fontawesome.com/kits/<kit-id>/setup
#      or from the example: <script src="https://kit.fontawesome.com/<kit-id>.js" crossorigin="anonymous"></script>
#      and paste only the <kit-id> here.
FONTAWESOME_KIT=


# -------------------------
# File storage
# -------------------------
# For large deployments, with many worlds, you can consider MinIO instead. 
# Therefore, see: .env. example.minio
# However, for most use cases, this should be fine
FILESYSTEM_DRIVER=public


# -------------------------
# Search (Meilisearch)
# -------------------------
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://localhost:7700 
#or MEILISEARCH_HOST=http://{host-ip}:7700, where you replace {host-ip} with the local ip of machine running kanka
MEILISEARCH_KEY=password

