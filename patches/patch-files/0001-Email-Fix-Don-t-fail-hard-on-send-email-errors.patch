 app/Jobs/Emails/EmailChangeJob.php            | 21 +++++++++++++-----
 app/Jobs/Emails/Purge/FirstWarningJob.php     |  5 ++++-
 app/Jobs/Emails/Purge/SecondWarningJob.php    |  3 ++-
 .../Emails/SubscriptionCancelEmailJob.php     | 15 +++++++++++--
