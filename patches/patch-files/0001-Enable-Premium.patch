From bbdfacb52116cbec856d1f0ecdb5feadd1083038 Mon Sep 17 00:00:00 2001
From: Sebastian Kinnewig <Sebastian@Kinnewig.org>
Date: Wed, 4 Nov 2026 12:11:25 +0100
Subject: [PATCH] Enable Premium

---
 app/Models/Concerns/UserBenefits.php    | 25 ++++---------------------
 app/Models/User.php                     | 17 ++++++-----------
 app/Services/Campaign/CreateService.php | 14 ++++++++++++++
 3 files changed, 24 insertions(+), 32 deletions(-)

diff --git a/app/Models/Concerns/UserBenefits.php b/app/Models/Concerns/UserBenefits.php
index 03b001059..95f4ebe02 100644
--- a/app/Models/Concerns/UserBenefits.php
+++ b/app/Models/Concerns/UserBenefits.php
@@ -15,7 +15,8 @@ trait UserBenefits
      */
     public function availableBenefits(): int
     {
-        return $this->maxBenefits() - $this->boosting();
+        // do not decrease the number of available benefits
+        return $this->maxBenefits();
     }
 
     /**
@@ -35,25 +36,7 @@ public function boosting(): int
      */
     public function maxBenefits(): int
     {
-        // Allows admins to give boosters to members of the community
-        $base = 0;
-        if (! empty($this->booster_count)) {
-            $base += $this->booster_count;
-        }
-
-        if (! $this->isSubscriber()) {
-            return $base;
-        }
-
-        if ($this->hasRole('admin')) {
-            return max(config('limits.benefits.admin'), $base);
-        }
-
-        $levels = config('limits.benefits.standard');
-        if ($this->hasLegacyBoosterNomenclature()) {
-            $levels = config('limits.benefits.legacy');
-        }
-
-        return Arr::get($levels, $this->pledge ?? 'unknown', 0) + $base;
+        // Hardcode `100` available benefits.
+        RETURN 100;
     }
 }
diff --git a/app/Models/User.php b/app/Models/User.php
index 995eef8b8..ac0e21081 100644
--- a/app/Models/User.php
+++ b/app/Models/User.php
@@ -142,9 +142,8 @@ public function hasCampaignRole(int $roleId): bool
     /**
      * Determine if a user is a subscriber
      */
-    public function isSubscriber(): bool
-    {
-        return $this->hasRole(Pledge::ROLE) || $this->hasRole('admin') || $this->onTrial();
+    public function isSubscriber(): bool {
+        return true;
     }
 
     /**
@@ -166,9 +165,8 @@ public function isGoblin(): bool
     /**
      * Determine if a user is an elemental
      */
-    public function isElemental(): bool
-    {
-        return (bool) (! empty($this->pledge) && $this->pledge == Pledge::ELEMENTAL);
+    public function isElemental(): bool {
+        return true;
     }
 
     public function isOwlbear(): bool
@@ -398,11 +396,8 @@ public function hasPayPal(): bool
     /**
      * Check if the user is subscribed via a manual sub
      */
-    public function hasManualSubscription(): bool
-    {
-        return $this->subscribed('kanka') &&
-            $this->subscription('kanka') &&
-            Str::startsWith($this->subscription('kanka')->stripe_id, 'manual_');
+    public function hasManualSubscription(): bool {
+        return true;
     }
 
     /**
diff --git a/app/Services/Campaign/CreateService.php b/app/Services/Campaign/CreateService.php
index 4f8f3a954..29313c512 100644
--- a/app/Services/Campaign/CreateService.php
+++ b/app/Services/Campaign/CreateService.php
@@ -15,6 +15,7 @@
 use App\Models\EntityType;
 use App\Notifications\Header;
 use App\Services\Users\CampaignService;
+use App\Services\Campaign\BoostService;
 use App\Traits\RequestAware;
 use App\Traits\UserAware;
 use Exception;
@@ -63,6 +64,19 @@ public function create(): Campaign
             throw $e;
         }
 
+        // Always enable premium for newly created campaigns:
+        try {
+            $boostService = app(BoostService::class);
+
+            $boostService
+                ->user($this->user)
+                ->campaign($this->campaign)
+                ->premium(automaticallyAssigned: true);
+        } catch (\Throwable $e) {
+            // Never fail campaign creation because of the boost
+            report($e);
+        }
+
         return $this->campaign;
     }
 
-- 
2.52.0

